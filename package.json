{
	"name": "pokerogue-lan",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"start": "vite",
		"build:coop-runtime": "node scripts/build-coop-runtime.mjs",
		"start:server": "node server/start.mjs",
		"start:local": "node scripts/start-local.mjs",
		"build:desktop": "node scripts/build-desktop.mjs",
		"start:desktop": "electron build/desktop/app",
		"package:desktop": "node scripts/package-desktop.mjs",
		"test:desktop": "node --test --test-concurrency=1 tests/desktop-runtime.test.mjs tests/desktop-storage.test.mjs tests/desktop-package.test.mjs tests/server-entry.test.mjs",
		"test:coop": "node --test --test-concurrency=1 tests/coop*.test.mjs",
		"test:battle-core": "node --test --test-concurrency=1 tests/battle-core*.test.mjs",
		"typecheck": "tsc --noEmit",
		"test:local-save": "node --test tests/local-save.test.mjs",
		"test:localization": "node --test tests/localization.test.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest watch --coverage",
		"review:code": "node scripts/review-code.mjs"
	},
	"devDependencies": {
		"@electron/packager": "20.3.0",
		"@types/node": "24.19.2",
		"@vitest/coverage-istanbul": "4.1.12",
		"electron": "45.0.0",
		"eslint": "^8.25.0",
		"fake-indexeddb": "6.2.4",
		"jsdom": "^24.0.0",
		"json-beautify": "^1.1.1",
		"phaser3spectorjs": "^0.0.8",
		"typescript": "^5.9.3",
		"vite": "6.4.5",
		"vitest": "4.1.12",
		"vitest-canvas-mock": "^0.3.3"
	},
	"dependencies": {
		"@material/material-color-utilities": "^0.2.7",
		"crypto-js": "^4.2.0",
		"i18next": "26.5.10",
		"json-stable-stringify": "^1.3.0",
		"phaser": "^3.70.0",
		"phaser3-rex-plugins": "^1.1.84",
		"ws": "8.22.0"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"imports": {
		"#app": "./src/main.js",
		"#app/*": "./src/*"
	},
	"overrides": {
		"phaser3-rex-plugins": {
			"i18next-http-backend": "4.0.6"
		}
	}
}
